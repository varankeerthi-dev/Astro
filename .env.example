# ── Public (browser-safe) ────────────────────────────────────────────────────
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
PUBLIC_APP_URL=https://app.perfecterp.com

# ── Server-only (never exposed to the browser; Vercel env, not committed) ────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PREVIEW_SECRET=any-random-32-plus-character-string
CRON_SECRET=any-random-32-plus-character-string   # protects /api/cron/publish-due
VERCEL_TOKEN=                                     # optional: cache-tag purge on publish
VERCEL_PROJECT_ID=

# ── Analytics (fallback IDs; Website Settings in the CMS override at runtime) ─
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_CLARITY_PROJECT_ID=
# Optional self-hosted Umami:
# PUBLIC_UMAMI_SRC=https://umami.example.com/script.js
# PUBLIC_UMAMI_HOST=https://umami.example.com

# ── Rollback flag (per-route content source; 'static' renders pre-CMS copy) ──
CONTENT_SOURCE=db
