---
// /blog — post list with category filter and pagination (Wave 6).
import Layout from '../../layouts/Layout.astro';
import { listBlogPosts, listKbCategories } from '../../lib/cms/query';
import { cacheHeaders, cacheTagsFor } from '../../lib/cache';

export const prerender = false;

const params = Astro.url.searchParams;
const page = Math.max(1, Number(params.get('page') ?? 1) || 1);
const category = params.get('category') ?? undefined;

const [{ rows, total, perPage }, categories] = await Promise.all([
  listBlogPosts({ page, perPage: 9, category }),
  listKbCategories().catch(() => []),
]);

const pages = Math.max(1, Math.ceil(total / perPage));

Astro.response.headers.set('Content-Type', 'text/html');
if (!Astro.locals.preview) {
  for (const [k, v] of Object.entries(cacheHeaders(cacheTagsFor('/blog')))) Astro.response.headers.set(k, v);
}
---
<Layout title="Blog" description="Product updates, guides, and stories from the team.">
  <section class="pt-32 pb-16 px-6 bg-white">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm font-semibold text-blue-600 uppercase tracking-wider mb-3">Blog</p>
      <h1 class="text-4xl md:text-5xl font-bold font-display tracking-tight text-slate-900">Latest from the team</h1>
      <p class="mt-3 text-slate-500 font-sans">Guides, product updates, and stories for growing businesses.</p>
      {categories.filter((c) => c.kind === 'user_guide').length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          <a href="/blog" class={`px-4 py-1.5 rounded-full text-sm font-semibold no-underline ${!category ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}>All</a>
          {categories.map((c) => (
            <a href={`/blog?category=${c.slug}`} class={`px-4 py-1.5 rounded-full text-sm font-semibold no-underline ${category === c.slug ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}>{c.name}</a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="px-6 pb-20">
    <div class="max-w-5xl mx-auto">
      {rows.length === 0 && <p class="text-slate-500 text-center py-16">No posts yet — check back soon.</p>}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {rows.map((p: any) => (
          <a href={p.page?.slug ?? '#'} class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col gap-3 no-underline hover:border-blue-300 hover:shadow-md transition-all" data-umami-event="blog-card-click" data-umami-props={JSON.stringify({ title: p.title })}>
            <span class="text-xs font-semibold uppercase tracking-wide text-blue-600">
              {p.category?.name ?? 'News'}
            </span>
            <h2 class="text-lg font-bold font-display text-slate-900 leading-snug m-0">{p.title}</h2>
            {p.excerpt && <p class="text-sm text-slate-500 leading-relaxed m-0 line-clamp-3 font-sans">{p.excerpt}</p>}
            <span class="mt-auto text-xs text-slate-400 font-sans">
              {p.reading_time_min ? `${p.reading_time_min} min read · ` : ''}
              {p.publish_at ? new Date(p.publish_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : ''}
            </span>
          </a>
        ))}
      </div>

      {pages > 1 && (
        <nav class="mt-12 flex items-center justify-center gap-3" aria-label="Pagination">
          {page > 1 && <a href={`/blog?page=${page - 1}${category ? `&category=${category}` : ''}`} class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm font-semibold no-underline hover:bg-slate-200">← Newer</a>}
          <span class="text-sm text-slate-500">Page {page} of {pages}</span>
          {page < pages && <a href={`/blog?page=${page + 1}${category ? `&category=${category}` : ''}`} class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm font-semibold no-underline hover:bg-slate-200">Older →</a>}
        </nav>
      )}
    </div>
  </section>
</Layout>
