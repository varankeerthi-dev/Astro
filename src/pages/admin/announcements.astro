---
// /admin/announcements — Wave 2 admin (kinds, themes, priority, windows,
// dismissible, display locations).
import AdminLayout from '../../layouts/AdminLayout.astro';
import { apiGet, apiSend, formToObject, STATUS_LABEL, STATUS_BADGE } from '../../lib/cms/admin-fetch';

export const prerender = false;

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const status = params.get('status') ?? '';
const page = Math.max(1, Number(params.get('page') ?? 1) || 1);
const perPage = 20;
const editId = params.get('edit') ?? '';
const newMode = params.get('new') === '1';
const notice = params.get('ok') ?? '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  try {
    if (action === 'create') {
      const payload = formToObject(form);
      delete payload._action;
      payload.dismissible = payload.dismissible !== null;
      payload.locations = payload.locations ? String(payload.locations).split(',').map((s: string) => s.trim()).filter(Boolean) : [];
      const res = await apiSend(Astro, '/api/admin/announcements', payload);
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/announcements?ok=created');
    } else if (action === 'update' && editId) {
      const payload = formToObject(form);
      delete payload._action;
      payload.dismissible = payload.dismissible !== null;
      payload.locations = payload.locations ? String(payload.locations).split(',').map((s: string) => s.trim()).filter(Boolean) : [];
      const res = await apiSend(Astro, `/api/admin/announcements/${editId}`, payload, 'PATCH');
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/announcements?ok=updated');
    } else if (action === 'status') {
      const id = String(form.get('id') ?? '');
      const to = String(form.get('to') ?? '');
      const body: Record<string, unknown> = { action: to };
      const at = String(form.get('at') ?? '');
      if (to === 'schedule' && at) body.at = new Date(at).toISOString();
      const res = await apiSend(Astro, `/api/admin/announcements/${id}`, body);
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/announcements?ok=' + to);
    } else if (action === 'duplicate') {
      const id = String(form.get('id') ?? '');
      const res = await apiSend(Astro, `/api/admin/announcements/${id}`, { action: 'duplicate' });
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/announcements?ok=duplicated');
    } else if (action === 'delete') {
      const id = String(form.get('id') ?? '');
      const res = await apiSend(Astro, `/api/admin/announcements/${id}`, {}, 'DELETE');
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/announcements?ok=deleted');
    }
  } catch (e: any) { error = e?.message ?? String(e); }
}

let list: { rows: any[]; total: number; page: number } = { rows: [], total: 0, page: 1 };
try {
  list = await apiGet(Astro, `/api/admin/announcements?q=${encodeURIComponent(q)}&status=${encodeURIComponent(status)}&page=${page}&perPage=${perPage}`);
} catch (e: any) { error = e?.message ?? String(e); }
let editRow: any = null;
if (editId) { try { editRow = await apiGet(Astro, `/api/admin/announcements/${editId}`); } catch {} }
const pages = Math.max(1, Math.ceil(list.total / perPage));
const inputCls = 'border border-slate-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-500/40 bg-white';
const labelCls = 'text-sm font-semibold text-slate-700';
const pick = (r: any, k: string) => (editRow ? (editRow[k] ?? '') : '');
const KINDS = ['information', 'new_feature', 'product_launch', 'celebration', 'holiday_wishes', 'offer', 'maintenance', 'alert'];
const THEMES = ['info', 'success', 'warning', 'danger', 'brand'];
---
<AdminLayout title="Announcements" active="/admin/announcements">
  {notice && <div class="mb-4 text-sm text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3">Done — {notice}.</div>}
  {error && <div class="mb-4 text-sm text-red-800 bg-red-50 border border-red-200 rounded-xl px-4 py-3">Error: {error}</div>}

  <div class="bg-white rounded-2xl border border-slate-200 p-5 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <form method="get" class="flex flex-wrap gap-2">
        <input type="search" name="q" value={q} placeholder="Search announcements…" class="border border-slate-300 rounded-full px-4 py-2 text-sm bg-white" />
        <select name="status" class="border border-slate-300 rounded-full px-4 py-2 text-sm bg-white">
          <option value="">All statuses</option>
          {Object.entries(STATUS_LABEL).map(([v, l]) => <option value={v} selected={status === v}>{l}</option>)}
        </select>
        <button type="submit" class="px-4 py-2 rounded-full bg-slate-800 text-white text-sm font-semibold cursor-pointer">Filter</button>
      </form>
      <a href="/admin/announcements?new=1" class="px-4 py-2 rounded-full bg-blue-600 text-white text-sm font-semibold no-underline">+ New announcement</a>
    </div>
  </div>

  {(newMode || editId) && (
    <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6">
      <h2 class="text-base font-bold font-display mb-4">{editId ? 'Edit announcement' : 'New announcement'}</h2>
      <form method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <input type="hidden" name="_action" value={editId ? 'update' : 'create'} />
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Kind</span>
          <select name="kind" class={inputCls}>{KINDS.map((k) => <option value={k} selected={pick(editRow, 'kind') === k}>{k.replace('_', ' ')}</option>)}</select></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Theme</span>
          <select name="theme" class={inputCls}>{THEMES.map((t) => <option value={t} selected={pick(editRow, 'theme') === t}>{t}</option>)}</select></label>
        <label class="flex flex-col gap-1.5 md:col-span-2"><span class={labelCls}>Title</span>
          <input class={inputCls} name="title" value={pick(editRow, 'title')} required /></label>
        <label class="flex flex-col gap-1.5 md:col-span-2"><span class={labelCls}>Description</span>
          <textarea class={inputCls} name="description" rows="2">{pick(editRow, 'description')}</textarea></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Button label</span>
          <input class={inputCls} name="button_label" value={pick(editRow, 'button_label')} /></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Button URL</span>
          <input class={inputCls} name="button_url" value={pick(editRow, 'button_url')} /></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Priority (higher wins)</span>
          <input type="number" class={inputCls} name="priority" value={pick(editRow, 'priority') ?? 0} /></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Display locations (comma-separated)</span>
          <input class={inputCls} name="locations" value={Array.isArray(pick(editRow, 'locations')) ? pick(editRow, 'locations').join(', ') : 'home_topbar'} /></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Start</span>
          <input type="datetime-local" class={inputCls} name="publish_at" value={pick(editRow, 'publish_at') ? String(pick(editRow, 'publish_at')).slice(0, 16) : ''} /></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>End</span>
          <input type="datetime-local" class={inputCls} name="unpublish_at" value={pick(editRow, 'unpublish_at') ? String(pick(editRow, 'unpublish_at')).slice(0, 16) : ''} /></label>
        <label class="flex items-center gap-2 text-sm text-slate-700 md:col-span-2">
          <input type="checkbox" name="dismissible" checked={editRow ? editRow.dismissible !== false : true} /> Dismissible (visitors can hide it)
        </label>
        <div class="md:col-span-2 flex gap-3">
          <button type="submit" class="px-6 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm cursor-pointer">Save draft</button>
          {editId && <a href="/admin/announcements" class="px-6 py-2.5 rounded-full bg-slate-100 text-slate-700 text-sm font-semibold no-underline">Cancel</a>}
        </div>
      </form>
    </div>
  )}

  <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
    {list.rows.length === 0 && <p class="text-sm text-slate-400 text-center py-12">No announcements found.</p>}
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-400">
        <tr><th class="px-4 py-3">Title</th><th class="px-4 py-3">Kind</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Priority</th><th class="px-4 py-3 text-right">Actions</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {list.rows.map((r: any) => (
          <tr class="hover:bg-slate-50/60">
            <td class="px-4 py-3 font-semibold text-slate-800">{r.title}</td>
            <td class="px-4 py-3 text-xs text-slate-500">{r.kind}</td>
            <td class="px-4 py-3"><span class={`text-[11px] font-bold uppercase px-2 py-0.5 rounded-full ${STATUS_BADGE[r.status]}`}>{STATUS_LABEL[r.status]}</span></td>
            <td class="px-4 py-3 text-slate-500">{r.priority}</td>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2 flex-wrap">
                {r.status !== 'published' && (
                  <form method="POST" class="inline"><input type="hidden" name="_action" value="status" /><input type="hidden" name="id" value={r.id} /><input type="hidden" name="to" value="publish" /><button class="text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-3 py-1.5 rounded-full cursor-pointer">Publish</button></form>
                )}
                {r.status !== 'archived' && (
                  <form method="POST" class="inline"><input type="hidden" name="_action" value="status" /><input type="hidden" name="id" value={r.id} /><input type="hidden" name="to" value="archive" /><button class="text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-full cursor-pointer">Archive</button></form>
                )}
                <form method="POST" class="inline"><input type="hidden" name="_action" value="duplicate" /><input type="hidden" name="id" value={r.id} /><button class="text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-full cursor-pointer">Duplicate</button></form>
                <a href={`/admin/announcements?edit=${r.id}`} class="text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-full no-underline">Edit</a>
                <form method="POST" class="inline" onsubmit="return confirm('Delete this announcement?')"><input type="hidden" name="_action" value="delete" /><input type="hidden" name="id" value={r.id} /><button class="text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-full cursor-pointer">Delete</button></form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {pages > 1 && (
    <nav class="mt-6 flex items-center justify-center gap-3">
      {page > 1 && <a href={`/admin/announcements?page=${page - 1}`} class="px-4 py-2 rounded-full bg-slate-100 text-sm font-semibold no-underline">← Prev</a>}
      <span class="text-sm text-slate-500">Page {page} of {pages}</span>
      {page < pages && <a href={`/admin/announcements?page=${page + 1}`} class="px-4 py-2 rounded-full bg-slate-100 text-sm font-semibold no-underline">Next →</a>}
    </nav>
  )}
</AdminLayout>
