---
// /admin/users — invite staff and manage roles (administrator only).
import AdminLayout from '../../layouts/AdminLayout.astro';
import { apiGet, apiSend } from '../../lib/cms/admin-fetch';
import { ROLE_LABELS } from '../../lib/auth/permissions';

export const prerender = false;

const notice = params0().get('ok') ?? '';
const params = Astro.url.searchParams;
let error = '';

function params0() { return Astro.url.searchParams; }

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  try {
    if (action === 'invite') {
      const res = await apiSend(Astro, '/api/admin/users', {
        email: String(form.get('email') ?? ''),
        password: String(form.get('password') ?? ''),
        full_name: String(form.get('full_name') ?? ''),
        role: String(form.get('role') ?? 'marketing_editor'),
      });
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/users?ok=invited');
    } else if (action === 'role') {
      const res = await apiSend(Astro, '/api/admin/users', {
        id: String(form.get('id') ?? ''),
        role: String(form.get('role') ?? ''),
      }, 'PATCH');
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/users?ok=role-updated');
    }
  } catch (e: any) { error = e?.message ?? String(e); }
}

let rows: any[] = [];
try {
  const data: any = await apiGet(Astro, '/api/admin/users');
  rows = Array.isArray(data) ? data : (data.rows ?? data.users ?? []);
} catch (e: any) { error = e?.message ?? String(e); }

const inputCls = 'border border-slate-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-500/40 bg-white';
const labelCls = 'text-sm font-semibold text-slate-700';
const ROLES = ['marketing_editor', 'publisher', 'administrator'];
---
<AdminLayout title="Users & Roles" active="/admin/users">
  {notice && <div class="mb-4 text-sm text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3">Done — {notice}.</div>}
  {error && <div class="mb-4 text-sm text-red-800 bg-red-50 border border-red-200 rounded-xl px-4 py-3">Error: {error}</div>}

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-white rounded-2xl border border-slate-200 p-6 self-start">
      <h2 class="text-base font-bold font-display mb-1">Invite a teammate</h2>
      <p class="text-xs text-slate-400 mb-4">Accounts are created instantly — no public signup exists.</p>
      <form method="POST" class="flex flex-col gap-4">
        <input type="hidden" name="_action" value="invite" />
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Full name</span>
          <input class={inputCls} name="full_name" required /></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Email</span>
          <input class={inputCls} type="email" name="email" required /></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Temporary password <span class="text-slate-400 font-normal">(min 8 chars)</span></span>
          <input class={inputCls} type="text" name="password" required minlength="8" /></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Role</span>
          <select name="role" class={inputCls}>
            {ROLES.map((r) => <option value={r}>{ROLE_LABELS[r as keyof typeof ROLE_LABELS]}</option>)}
          </select></label>
        <button type="submit" class="self-start px-6 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm cursor-pointer">Invite</button>
      </form>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden lg:col-span-2 self-start">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-400">
          <tr><th class="px-4 py-3">User</th><th class="px-4 py-3">Role</th><th class="px-4 py-3 text-right">Change role</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {rows.map((u: any) => (
            <tr class="hover:bg-slate-50/60">
              <td class="px-4 py-3">
                <p class="font-semibold text-slate-800 m-0">{u.full_name || u.email}</p>
                <p class="text-xs text-slate-400 m-0">{u.email}</p>
              </td>
              <td class="px-4 py-3">
                <span class="text-[11px] font-bold uppercase px-2 py-0.5 rounded-full bg-blue-50 text-blue-700">
                  {ROLE_LABELS[(u.role ?? 'marketing_editor') as keyof typeof ROLE_LABELS] ?? u.role}
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                <form method="POST" class="inline-flex items-center gap-2">
                  <input type="hidden" name="_action" value="role" />
                  <input type="hidden" name="id" value={u.id} />
                  <select name="role" class="border border-slate-300 rounded-full px-3 py-1.5 text-xs bg-white">
                    {ROLES.map((r) => <option value={r} selected={u.role === r}>{r}</option>)}
                  </select>
                  <button type="submit" class="text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-full cursor-pointer">Save</button>
                </form>
              </td>
            </tr>
          ))}
          {rows.length === 0 && <tr><td class="px-4 py-8 text-center text-sm text-slate-400" colSpan={3}>No users found.</td></tr>}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
