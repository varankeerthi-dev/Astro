---
// /admin/media — media library (grid, folders, search, upload/replace,
// alt/caption, usage tracking). Uploads go through /api/admin/media,
// which slugifies filenames and generates WebP variants with sharp.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { apiGet, apiSend, STATUS_LABEL } from '../../lib/cms/admin-fetch';
import { mediaUrl } from '../../lib/cms/query';

export const prerender = false;

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const folderId = params.get('folder_id') ?? '';
const page = Math.max(1, Number(params.get('page') ?? 1) || 1);
const perPage = 24;
const notice = params.get('ok') ?? '';
let error = '';

if (Astro.request.method === 'POST' && Astro.request.headers.get('content-type')?.includes('application/json')) {
  const form = await Astro.request.json().catch(() => null);
  if (form?.name) {
    const res = await apiSend(Astro, '/api/admin/media', { name: String(form.name), parent_id: form.parent_id || null });
    if (!res.ok) error = res.error;
    else return Astro.redirect('/admin/media?ok=folder-created');
  }
}

let list: any = { rows: [], total: 0, page: 1, folders: [] };
try {
  list = await apiGet(Astro, `/api/admin/media?q=${encodeURIComponent(q)}&folder_id=${encodeURIComponent(folderId)}&page=${page}&perPage=${perPage}`);
} catch (e: any) { error = e?.message ?? String(e); }
const folders = list.folders ?? [];
const pages = Math.max(1, Math.ceil(list.total / perPage));
const inputCls = 'border border-slate-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-500/40 bg-white';
const labelCls = 'text-sm font-semibold text-slate-700';
---
<AdminLayout title="Media Library" active="/admin/media">
  {notice && <div class="mb-4 text-sm text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3">Done — {notice}.</div>}
  {error && <div class="mb-4 text-sm text-red-800 bg-red-50 border border-red-200 rounded-xl px-4 py-3">Error: {error}</div>}

  <div class="bg-white rounded-2xl border border-slate-200 p-5 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <form method="get" class="flex flex-wrap gap-2">
        <input type="search" name="q" value={q} placeholder="Search files…" class="border border-slate-300 rounded-full px-4 py-2 text-sm bg-white" />
        <select name="folder_id" class="border border-slate-300 rounded-full px-4 py-2 text-sm bg-white">
          <option value="">All folders</option>
          {folders.map((f: any) => <option value={f.id} selected={folderId === f.id}>{f.path}</option>)}
        </select>
        <button type="submit" class="px-4 py-2 rounded-full bg-slate-800 text-white text-sm font-semibold cursor-pointer">Filter</button>
      </form>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-6">
    <div class="bg-white rounded-2xl border border-slate-200 p-6 lg:col-span-1 self-start">
      <h2 class="text-base font-bold font-display mb-4">Upload</h2>
      <form id="upload-form" enctype="multipart/form-data" class="flex flex-col gap-3">
        <label class="flex flex-col gap-1.5"><span class={labelCls}>File (WebP/PNG/JPEG → variants generated)</span>
          <input type="file" name="file" required class="text-sm" accept="image/*" /></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Folder</span>
          <select name="folder_id" class={inputCls}>
            <option value="">misc</option>
            {folders.map((f: any) => <option value={f.id}>{f.path}</option>)}
          </select></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Alt text (required for SEO)</span>
          <input class={inputCls} name="alt_text" /></label>
        <label class="flex flex-col gap-1.5"><span class={labelCls}>Caption</span>
          <input class={inputCls} name="caption" /></label>
        <button type="submit" class="px-5 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm cursor-pointer">Upload</button>
      </form>
      <form id="folder-form" class="mt-5 pt-5 border-t border-slate-100 flex gap-2">
        <input name="name" placeholder="New folder…" class="border border-slate-300 rounded-full px-4 py-2 text-sm bg-white flex-1" />
        <button type="submit" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm font-semibold cursor-pointer">Add</button>
      </form>
    </div>

    <div class="lg:col-span-3">
      {list.rows.length === 0 && <p class="text-sm text-slate-400 text-center py-16 bg-white rounded-2xl border border-slate-200">No files yet — upload your first image.</p>}
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {list.rows.map((r: any) => (
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <div class="aspect-video bg-slate-100">
              <img src={mediaUrl(r.storage_path)} alt={r.alt_text || r.filename} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div class="p-3">
              <p class="text-xs font-semibold text-slate-800 truncate m-0" title={r.filename}>{r.filename}</p>
              <p class="text-[11px] text-slate-400 m-0 mt-0.5">
                {r.width && r.height ? `${r.width}×${r.height} · ` : ''}{r.mime} · used {r.usage_count}×
              </p>
              <p class="text-[11px] text-slate-500 m-0 mt-0.5 line-clamp-2">{r.alt_text || <em class="text-amber-600">no alt text</em>}</p>
              <div class="mt-2 flex gap-2">
                <button type="button" data-copy-url={mediaUrl(r.storage_path)} class="text-[11px] font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 px-2.5 py-1 rounded-full cursor-pointer">Copy URL</button>
                <button type="button" data-delete-media={r.id} class="text-[11px] font-semibold text-red-600 bg-red-50 hover:bg-red-100 px-2.5 py-1 rounded-full cursor-pointer">Delete</button>
              </div>
            </div>
          </div>
        ))}
      </div>
      {pages > 1 && (
        <nav class="mt-6 flex items-center justify-center gap-3">
          {page > 1 && <a href={`/admin/media?q=${encodeURIComponent(q)}&folder_id=${encodeURIComponent(folderId)}&page=${page - 1}`} class="px-4 py-2 rounded-full bg-slate-100 text-sm font-semibold no-underline">← Prev</a>}
          <span class="text-sm text-slate-500">Page {page} of {pages}</span>
          {page < pages && <a href={`/admin/media?q=${encodeURIComponent(q)}&folder_id=${encodeURIComponent(folderId)}&page=${page + 1}`} class="px-4 py-2 rounded-full bg-slate-100 text-sm font-semibold no-underline">Next →</a>}
        </nav>
      )}
    </div>
  </div>
</AdminLayout>
<script>
  const uploadForm = document.getElementById('upload-form');
  if (uploadForm) {
    uploadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(uploadForm);
      const res = await fetch('/api/admin/media', { method: 'POST', body: fd });
      if (res.ok) window.location.href = '/admin/media?ok=uploaded';
      else {
        const data = await res.json().catch(() => null);
        alert(data?.error ? `Upload failed: ${data.error}` : `Upload failed (HTTP ${res.status})`);
      }
    });
  }
  const folderForm = document.getElementById('folder-form');
  if (folderForm) {
    folderForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = folderForm.querySelector('input[name="name"]').value.trim();
      if (!name) return;
      const res = await fetch('/api/admin/media', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      if (res.ok) window.location.href = '/admin/media?ok=folder-created';
      else { const d = await res.json().catch(() => null); alert(d?.error ?? 'Folder create failed'); }
    });
  }
  document.querySelectorAll('[data-copy-url]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(btn.getAttribute('data-copy-url')); btn.textContent = '✓ Copied'; } catch (_) {}
    });
  });
  document.querySelectorAll('[data-delete-media]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this file?')) return;
      const res = await fetch(`/api/admin/media/${btn.getAttribute('data-delete-media')}`, { method: 'DELETE' });
      if (res.ok) window.location.reload();
      else { const d = await res.json().catch(() => null); alert(d?.error ?? 'Delete failed'); }
    });
  });
</script>
