---
// /admin/help — KB articles (markdown editor v1), categories, and the
// suggested-edits inbox (Phase 7).
import AdminLayout from '../../layouts/AdminLayout.astro';
import { apiGet, apiSend, formToObject, STATUS_LABEL, STATUS_BADGE } from '../../lib/cms/admin-fetch';
import { supabaseAdmin } from '../../lib/supabase/admin';

export const prerender = false;

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const status = params.get('status') ?? '';
const page = Math.max(1, Number(params.get('page') ?? 1) || 1);
const perPage = 20;
const editId = params.get('edit') ?? '';
const newMode = params.get('new') === '1';
const tab = params.get('tab') ?? 'articles';
const notice = params.get('ok') ?? '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  try {
    if (action === 'create') {
      const payload = formToObject(form);
      delete payload._action;
      const res = await apiSend(Astro, '/api/admin/kb', payload);
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/help?ok=created');
    } else if (action === 'update' && editId) {
      const payload = formToObject(form);
      delete payload._action;
      const res = await apiSend(Astro, `/api/admin/kb/${editId}`, payload, 'PATCH');
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/help?ok=updated');
    } else if (action === 'status') {
      const id = String(form.get('id') ?? '');
      const to = String(form.get('to') ?? '');
      const body: Record<string, unknown> = { action: to };
      const at = String(form.get('at') ?? '');
      if (to === 'schedule' && at) body.at = new Date(at).toISOString();
      const res = await apiSend(Astro, `/api/admin/kb/${id}`, body);
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/help?ok=' + to);
    } else if (action === 'delete') {
      const id = String(form.get('id') ?? '');
      const res = await apiSend(Astro, `/api/admin/kb/${id}`, {}, 'DELETE');
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/help?ok=deleted');
    } else if (action === 'category') {
      const res = await apiSend(Astro, '/api/admin/kb/categories', {
        name: String(form.get('name') ?? '').trim(),
        kind: String(form.get('kind') ?? 'user_guide'),
      });
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/help?ok=category-added');
    } else if (action === 'edit-review') {
      const id = String(form.get('id') ?? '');
      const state = String(form.get('state') ?? '');
      const res = await apiSend(Astro, '/api/admin/kb/suggested-edits', { id, state });
      if (!res.ok) error = res.error; else return Astro.redirect('/admin/help?tab=edits&ok=reviewed');
    }
  } catch (e: any) { error = e?.message ?? String(e); }
}

let list: { rows: any[]; total: number; page: number } = { rows: [], total: 0, page: 1 };
try {
  list = await apiGet(Astro, `/api/admin/kb?q=${encodeURIComponent(q)}&status=${encodeURIComponent(status)}&page=${page}&perPage=${perPage}`);
} catch (e: any) { error = e?.message ?? String(e); }
let editRow: any = null;
if (editId) { try { editRow = await apiGet(Astro, `/api/admin/kb/${editId}`); } catch {} }
let suggestions: any[] = [];
if (tab === 'edits') {
  try { suggestions = await apiGet(Astro, '/api/admin/kb/suggested-edits?state=open'); } catch {}
}
const [{ data: categories }, { data: feedback }] = await Promise.all([
  supabaseAdmin.from('kb_categories').select('id, name, kind').order('display_order'),
  supabaseAdmin.from('kb_feedback').select('helpful, count(id)').group('helpful'),
]);
const pages = Math.max(1, Math.ceil(list.total / perPage));
const inputCls = 'border border-slate-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-500/40 bg-white';
const labelCls = 'text-sm font-semibold text-slate-700';
const pick = (r: any, k: string) => (editRow ? (editRow[k] ?? '') : '');
const KINDS = ['user_guide', 'faq', 'release_note', 'troubleshooting', 'feature_documentation', 'video_tutorial', 'tips_and_tricks', 'api_documentation'];
const DIFFICULTY = ['beginner', 'intermediate', 'advanced'];
const feedbackMap = new Map((feedback ?? []).map((f: any) => [String(f.helpful), Number(f.count)]));
---
<AdminLayout title="Knowledge Base" active="/admin/help">
  {notice && <div class="mb-4 text-sm text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3">Done — {notice}.</div>}
  {error && <div class="mb-4 text-sm text-red-800 bg-red-50 border border-red-200 rounded-xl px-4 py-3">Error: {error}</div>}

  <div class="flex items-center justify-between mb-5">
    <div class="flex gap-2">
      <a href="/admin/help?tab=articles" class={`px-4 py-2 rounded-full text-sm font-semibold no-underline ${tab === 'articles' ? 'bg-blue-600 text-white' : 'bg-white text-slate-600 border border-slate-200'}`}>Articles</a>
      <a href="/admin/help?tab=edits" class={`px-4 py-2 rounded-full text-sm font-semibold no-underline ${tab === 'edits' ? 'bg-blue-600 text-white' : 'bg-white text-slate-600 border border-slate-200'}`}>Suggested edits ({suggestions.length})</a>
    </div>
    <a href="/admin/help?new=1" class="px-4 py-2 rounded-full bg-blue-600 text-white text-sm font-semibold no-underline">+ New article</a>
  </div>

  {tab === 'articles' && (
    <>
      <div class="bg-white rounded-2xl border border-slate-200 p-5 mb-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <form method="get" class="flex flex-wrap gap-2">
            <input type="hidden" name="tab" value="articles" />
            <input type="search" name="q" value={q} placeholder="Search articles…" class="border border-slate-300 rounded-full px-4 py-2 text-sm bg-white" />
            <select name="status" class="border border-slate-300 rounded-full px-4 py-2 text-sm bg-white">
              <option value="">All statuses</option>
              {Object.entries(STATUS_LABEL).map(([v, l]) => <option value={v} selected={status === v}>{l}</option>)}
            </select>
            <button type="submit" class="px-4 py-2 rounded-full bg-slate-800 text-white text-sm font-semibold cursor-pointer">Filter</button>
          </form>
          <form method="POST" class="flex items-center gap-2">
            <input type="hidden" name="_action" value="category" />
            <input name="name" placeholder="New category…" class="border border-slate-300 rounded-full px-4 py-2 text-sm bg-white" />
            <select name="kind" class="border border-slate-300 rounded-full px-4 py-2 text-sm bg-white">
              {KINDS.map((k) => <option value={k}>{k.replace('_', ' ')}</option>)}
            </select>
            <button type="submit" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm font-semibold cursor-pointer">Add</button>
          </form>
        </div>
      </div>

      {(newMode || editId) && (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6">
          <h2 class="text-base font-bold font-display mb-4">{editId ? 'Edit article' : 'New article'}</h2>
          <form method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="hidden" name="_action" value={editId ? 'update' : 'create'} />
            <label class="flex flex-col gap-1.5 md:col-span-2"><span class={labelCls}>Title</span>
              <input class={inputCls} name="title" value={pick(editRow, 'title')} required /></label>
            <label class="flex flex-col gap-1.5"><span class={labelCls}>Kind</span>
              <select name="kind" class={inputCls}>{KINDS.map((k) => <option value={k} selected={pick(editRow, 'kind') === k}>{k.replace('_', ' ')}</option>)}</select></label>
            <label class="flex flex-col gap-1.5"><span class={labelCls}>Category</span>
              <select name="category_id" class={inputCls}>
                <option value="">— none —</option>
                {(categories ?? []).map((c) => <option value={c.id} selected={pick(editRow, 'category_id') === c.id}>{c.name}</option>)}
              </select></label>
            <label class="flex flex-col gap-1.5"><span class={labelCls}>Module</span>
              <input class={inputCls} name="module" value={pick(editRow, 'module')} placeholder="CRM, Inventory, Site Visits…" /></label>
            <label class="flex flex-col gap-1.5"><span class={labelCls}>Difficulty</span>
              <select name="difficulty" class={inputCls}>{DIFFICULTY.map((d) => <option value={d} selected={pick(editRow, 'difficulty') === d}>{d}</option>)}</select></label>
            <label class="flex flex-col gap-1.5 md:col-span-2"><span class={labelCls}>Summary</span>
              <textarea class={inputCls} name="summary" rows="2">{pick(editRow, 'summary')}</textarea></label>
            <label class="flex flex-col gap-1.5 md:col-span-2"><span class={labelCls}>Body (Markdown — callouts, steps, tables supported)</span>
              <textarea class={`${inputCls} h-72 font-mono`} name="content_md" placeholder="## How to…">{pick(editRow, 'content_md')}</textarea></label>
            <label class="flex flex-col gap-1.5"><span class={labelCls}>Search keywords (comma-separated)</span>
              <input class={inputCls} name="keywords" value={Array.isArray(pick(editRow, 'keywords')) ? pick(editRow, 'keywords').join(', ') : ''} /></label>
            <label class="flex flex-col gap-1.5"><span class={labelCls}>Tags (comma-separated)</span>
              <input class={inputCls} name="tags" value={Array.isArray(pick(editRow, 'tags')) ? pick(editRow, 'tags').join(', ') : ''} /></label>
            <label class="flex flex-col gap-1.5"><span class={labelCls}>Publish at (schedule)</span>
              <input type="datetime-local" class={inputCls} name="publish_at" value={pick(editRow, 'publish_at') ? String(pick(editRow, 'publish_at')).slice(0, 16) : ''} /></label>
            <div class="md:col-span-2 flex gap-3">
              <button type="submit" class="px-6 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm cursor-pointer">Save draft</button>
              {editId && <a href="/admin/help" class="px-6 py-2.5 rounded-full bg-slate-100 text-slate-700 text-sm font-semibold no-underline">Cancel</a>}
            </div>
          </form>
        </div>
      )}

      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
        {list.rows.length === 0 && <p class="text-sm text-slate-400 text-center py-12">No articles yet.</p>}
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-400">
            <tr><th class="px-4 py-3">Title</th><th class="px-4 py-3">Kind</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Helpful</th><th class="px-4 py-3 text-right">Actions</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {list.rows.map((r: any) => (
              <tr class="hover:bg-slate-50/60">
                <td class="px-4 py-3 font-semibold text-slate-800">{r.title}</td>
                <td class="px-4 py-3 text-xs text-slate-500">{r.kind}</td>
                <td class="px-4 py-3"><span class={`text-[11px] font-bold uppercase px-2 py-0.5 rounded-full ${STATUS_BADGE[r.status]}`}>{STATUS_LABEL[r.status]}</span></td>
                <td class="px-4 py-3 text-xs text-slate-500">{r.helpful_yes ?? 0}✓ / {r.helpful_no ?? 0}✗</td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-2 flex-wrap">
                    {r.status !== 'published' && (
                      <form method="POST" class="inline"><input type="hidden" name="_action" value="status" /><input type="hidden" name="id" value={r.id} /><input type="hidden" name="to" value="publish" /><button class="text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-3 py-1.5 rounded-full cursor-pointer">Publish</button></form>
                    )}
                    {r.status !== 'archived' && (
                      <form method="POST" class="inline"><input type="hidden" name="_action" value="status" /><input type="hidden" name="id" value={r.id} /><input type="hidden" name="to" value="archive" /><button class="text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-full cursor-pointer">Archive</button></form>
                    )}
                    <a href={`/admin/help?edit=${r.id}`} class="text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-full no-underline">Edit</a>
                    <a href={r.page?.slug ?? '#'} class="text-xs font-semibold text-slate-500 hover:text-slate-700 px-1.5 no-underline" target="_blank" rel="noopener">View</a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {pages > 1 && (
        <nav class="mt-6 flex items-center justify-center gap-3">
          {page > 1 && <a href={`/admin/help?tab=articles&page=${page - 1}`} class="px-4 py-2 rounded-full bg-slate-100 text-sm font-semibold no-underline">← Prev</a>}
          <span class="text-sm text-slate-500">Page {page} of {pages}</span>
          {page < pages && <a href={`/admin/help?tab=articles&page=${page + 1}`} class="px-4 py-2 rounded-full bg-slate-100 text-sm font-semibold no-underline">Next →</a>}
        </nav>
      )}
    </>
  )}

  {tab === 'edits' && (
    <div class="bg-white rounded-2xl border border-slate-200 p-6">
      <p class="text-sm text-slate-500 mb-4">Reader suggestions awaiting review — {feedbackMap.get('true') ?? 0} helpful votes, {feedbackMap.get('false') ?? 0} not-helpful votes recorded so far.</p>
      {suggestions.length === 0 && <p class="text-sm text-slate-400">No open suggestions. The inbox fills when readers use the “Suggest an edit” form on articles.</p>}
      <div class="flex flex-col gap-4">
        {suggestions.map((s: any) => (
          <div class="border border-slate-200 rounded-xl p-4">
            <p class="text-sm text-slate-600 font-sans">{s.suggestion}</p>
            <p class="mt-2 text-xs text-slate-400">
              {s.contact_email || 'Anonymous'} · <a href={s.article?.page?.slug ?? '#'} class="text-blue-600 no-underline">{s.article?.title}</a> · {new Date(s.created_at).toLocaleString()}
            </p>
            <div class="mt-3 flex gap-2">
              <form method="POST" class="inline"><input type="hidden" name="_action" value="edit-review" /><input type="hidden" name="id" value={s.id} /><input type="hidden" name="state" value="accepted" /><button class="text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-3 py-1.5 rounded-full cursor-pointer">Accept</button></form>
              <form method="POST" class="inline"><input type="hidden" name="_action" value="edit-review" /><input type="hidden" name="id" value={s.id} /><input type="hidden" name="state" value="rejected" /><button class="text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-full cursor-pointer">Reject</button></form>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}
</AdminLayout>
