---
// /admin/login — invite-only sign in (accounts live in the public.users
// table, created via scripts/create-admin.mjs or /admin/users).
import '../../styles/global.css';
import { getSessionProfile, startSession } from '../../lib/auth/session';
import { verifyPassword } from '../../lib/auth/passwords';
import { query, queryOne, dbReady } from '../../lib/db';

export const prerender = false;

// Already signed in? Go straight to the dashboard.
const existing = await getSessionProfile(Astro.cookies);
if (existing) return Astro.redirect('/admin');

let error = Astro.url.searchParams.get('error') ? 'Invalid email or password.' : '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');

  if (!dbReady) {
    error = 'CMS is not configured yet — set DATABASE_URL (see PHASE0-SETUP.md).';
  } else {
    try {
      const user = await queryOne<{ id: string; password_hash: string }>(
        `select id, password_hash from public.users where email = $1`,
        [email],
      );
      if (!user || !verifyPassword(password, user.password_hash)) {
        error = 'Invalid email or password.';
      } else {
        await startSession(Astro.cookies, user.id);
        try {
          await query(
            `insert into public.audit_log (action, entity, summary) values ('login', 'session', $1)`,
            [`Sign-in: ${email}`],
          );
        } catch { /* auditing is best-effort */ }
        const next = Astro.url.searchParams.get('next');
        return Astro.redirect(next && next.startsWith('/admin') ? next : '/admin');
      }
    } catch {
      error = 'Invalid email or password.';
    }
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Sign in | CMS Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-100 text-slate-900 antialiased font-sans min-h-screen flex items-center justify-center px-6">
    <div class="w-full max-w-sm">
      <div class="flex items-center justify-center gap-2.5 mb-8">
        <div class="w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center font-bold text-white font-display">B</div>
        <span class="text-xl font-bold font-display">CMS Admin</span>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
        <h1 class="text-lg font-bold font-display mb-1">Sign in</h1>
        <p class="text-sm text-slate-500 mb-6">Accounts are invite-only. Ask an administrator for access.</p>
        {error && (
          <div class="mb-4 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2">{error}</div>
        )}
        <form method="POST" class="flex flex-col gap-4">
          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-700">Email</span>
            <input type="email" name="email" required autocomplete="email"
              class="border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500" />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-700">Password</span>
            <input type="password" name="password" required autocomplete="current-password"
              class="border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500" />
          </label>
          <button type="submit"
            class="mt-2 w-full px-5 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-colors">
            Sign in
          </button>
        </form>
      </div>
      <p class="text-center mt-6"><a href="/" class="text-xs text-slate-400 hover:text-slate-600 no-underline">← Back to site</a></p>
    </div>
  </body>
</html>
