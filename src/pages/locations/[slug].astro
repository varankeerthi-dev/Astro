---
// /locations/[slug] — Phase 4 location landing pages (DB-driven).
import Layout from '../../layouts/Layout.astro';
import { getLocationBySlug, mediaUrl } from '../../lib/cms/query';
import { renderMarkdown } from '../../lib/md';
import { breadcrumb, faqPage, servicePage } from '../../lib/seo/jsonld';
import { cacheHeaders, cacheTagsFor } from '../../lib/cache';

export const prerender = false;

const { slug } = Astro.params;
const loc = await getLocationBySlug(slug!, { includeDrafts: Astro.locals.preview });

if (!loc) return Astro.redirect('/404');

const site = import.meta.env.SITE?.replace(/\/$/, '') ?? 'https://perfecterp.com';
const path = `/locations/${slug}`;
const page = loc.page as Record<string, any>;
const seo = (page?.page_seo ?? null) as Record<string, any> | null;
const title = seo?.seo_title || `${loc.hero_heading || loc.city} | ${loc.city} ERP Software`;
const body = renderMarkdown(loc.description_md ?? '');

const faqs: { q: string; a: string }[] = Array.isArray(loc.faqs) ? (loc.faqs as any[]) : [];
const testimonials: any[] = Array.isArray(loc.testimonials) ? (loc.testimonials as any[]) : [];
const contact: Record<string, string> = (loc.contact ?? {}) as Record<string, string>;

const jsonld = [
  servicePage({ city: loc.city, state: loc.state, name: `${loc.city} ERP Software`, url: `${site}${path}`, description: seo?.meta_description || loc.hero_subheading || '' }),
  breadcrumb([{ name: 'Industries', url: `${site}/industries` }, { name: `${loc.city} ERP Software`, url: `${site}${path}` }]),
  ...(faqs.length ? [faqPage(faqs)] : []),
];

Astro.response.headers.set('Content-Type', 'text/html');
if (!Astro.locals.preview) {
  for (const [k, v] of Object.entries(cacheHeaders(cacheTagsFor(path)))) Astro.response.headers.set(k, v);
}
---
<Layout title={title} description={seo?.meta_description || loc.hero_subheading} seo={seo} jsonld={jsonld}>
  <section class="pt-32 pb-16 px-6 bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-semibold text-blue-600 uppercase tracking-wider mb-3">ERP Software in {loc.city}, {loc.state}</p>
      <h1 class="text-4xl md:text-6xl font-bold font-display tracking-tight text-slate-900 leading-tight">
        {loc.hero_heading || `ERP Software ${loc.city}`}
      </h1>
      {loc.hero_subheading && <p class="mt-4 text-slate-500 text-lg max-w-xl mx-auto font-sans">{loc.hero_subheading}</p>}
      {loc.cta_label && (
        <a href={loc.cta_url || '/pricing'} class="inline-block mt-8 px-7 py-3.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm no-underline" data-umami-event="cta-click" data-umami-props={JSON.stringify({ location: 'location-hero', city: loc.city })}>
          {loc.cta_label}
        </a>
      )}
    </div>
  </section>

  {loc.banner_media_id && (
    <div class="px-6 pb-16">
      <div class="max-w-5xl mx-auto rounded-3xl overflow-hidden shadow-sm">
        <img src={mediaUrl((loc.banner_path as string) ?? '')} alt={loc.city} class="w-full h-72 md:h-96 object-cover" loading="lazy" decoding="async" />
      </div>
    </div>
  )}

  <section class="px-6 pb-16" data-section="location-body">
    <div class="max-w-3xl mx-auto prose prose-slate">
      <Fragment set:html={body.html} />
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="px-6 pb-16 bg-slate-50 py-16" data-section="location-testimonials">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold font-display text-center mb-10">What {loc.city} businesses say</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {testimonials.map((t) => (
            <figure class="bg-white rounded-2xl border border-slate-200 p-6">
              <blockquote class="text-slate-700 text-sm leading-relaxed m-0">“{t.quote}”</blockquote>
              <figcaption class="mt-4 text-sm font-semibold text-slate-900">
                {t.name}{t.company ? <span class="font-normal text-slate-500"> — {t.company}</span> : null}
                {t.rating ? <span class="text-amber-500 ml-2">{'★'.repeat(Number(t.rating))}</span> : null}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {faqs.length > 0 && (
    <section class="px-6 py-16" data-section="location-faqs">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold font-display mb-8 text-center">Frequently asked questions</h2>
        <div class="flex flex-col gap-3">
          {faqs.map((f) => (
            <details class="bg-white rounded-xl border border-slate-200 px-5 py-4 group">
              <summary class="font-semibold text-slate-800 cursor-pointer list-none flex justify-between items-center gap-4">{f.q}<span class="text-slate-400 group-open:rotate-45 transition-transform">+</span></summary>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed m-0">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {(Object.keys(contact).length > 0 || loc.map_embed_url) && (
    <section class="px-6 pb-20" data-section="location-contact">
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
          <h2 class="text-xl font-bold font-display mb-4">Talk to us about {loc.city}</h2>
          <ul class="list-none p-0 m-0 flex flex-col gap-2 text-sm text-slate-600 font-sans">
            {contact.phone && <li>📞 <a href={`tel:${contact.phone}`} class="no-underline text-slate-600 hover:text-blue-600">{contact.phone}</a></li>}
            {contact.email && <li>✉️ <a href={`mailto:${contact.email}`} class="no-underline text-slate-600 hover:text-blue-600">{contact.email}</a></li>}
            {contact.address && <li>📍 {contact.address}</li>}
          </ul>
          <a href="/" class="inline-block mt-6 px-6 py-3 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm no-underline" data-umami-event="cta-click" data-umami-props={JSON.stringify({ location: 'location-contact', city: loc.city })}>
            {loc.cta_label || 'Book a Demo'}
          </a>
        </div>
        {loc.map_embed_url && (
          <iframe src={loc.map_embed_url} class="w-full h-72 rounded-2xl border border-slate-200" loading="lazy" title={`Map of ${loc.city}`} />
        )}
      </div>
    </section>
  )}
</Layout>
