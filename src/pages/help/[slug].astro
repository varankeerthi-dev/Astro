---
// /help/[slug] — DB-driven KB article. Extends the existing visual system:
// per-category palettes, sticky TOC with scroll-spy, breadcrumbs, reading
// time, "was this helpful?" feedback, suggest-an-edit, copy link, print view.
import Layout from '../../layouts/Layout.astro';
import { getKbArticleBySlug, listKbArticles } from '../../lib/cms/query';
import { renderMarkdown, readingTime } from '../../lib/md';
import { breadcrumb, techArticle } from '../../lib/seo/jsonld';
import { cacheHeaders, cacheTagsFor } from '../../lib/cache';

export const prerender = false;

const { slug } = Astro.params;
const article: any = await getKbArticleBySlug(slug!, { includeDrafts: Astro.locals.preview });

if (!article) return Astro.redirect('/404');

const site = import.meta.env.SITE?.replace(/\/$/, '') ?? 'https://perfecterp.com';
const path = `/help/${slug}`;
const body = renderMarkdown(article.content_md ?? '');
const minutes = article.reading_time_min || readingTime(article.content_md ?? '');
const paletteKey = (article.category?.palette_key as string) ?? 'blue';

const PALETTES: Record<string, { accent: string; bg: string; soft: string }> = {
  blue: { accent: 'text-blue-600', bg: 'bg-blue-50', soft: 'bg-blue-50/60' },
  emerald: { accent: 'text-emerald-600', bg: 'bg-emerald-50', soft: 'bg-emerald-50/60' },
  amber: { accent: 'text-amber-600', bg: 'bg-amber-50', soft: 'bg-amber-50/60' },
  rose: { accent: 'text-rose-600', bg: 'bg-rose-50', soft: 'bg-rose-50/60' },
  violet: { accent: 'text-violet-600', bg: 'bg-violet-50', soft: 'bg-violet-50/60' },
};
const palette = PALETTES[paletteKey] ?? PALETTES.blue;

const related = await listKbArticles({ category: article.category?.slug, limit: 10 }).then(
  (rows: any[]) => rows.filter((r: any) => r.id !== article.id).slice(0, 3),
);

const jsonld = [
  techArticle({
    title: article.title,
    description: article.summary || '',
    url: `${site}${path}`,
    dateModified: article.updated_at,
    author: article.author?.full_name ?? 'Origin-ERP Team',
  }),
  breadcrumb([{ name: 'Help Center', url: `${site}/help` }, { name: article.title, url: `${site}${path}` }]),
];

Astro.response.headers.set('Content-Type', 'text/html');
if (!Astro.locals.preview) {
  for (const [k, v] of Object.entries(cacheHeaders(cacheTagsFor(path)))) Astro.response.headers.set(k, v);
}
---
<Layout title={article.title} description={article.summary} seo={null} jsonld={jsonld}>
  <article class="pt-32 pb-20 px-6 bg-white">
    <div class="max-w-5xl mx-auto">
      <nav class="text-xs text-slate-400 font-sans mb-6" aria-label="Breadcrumb">
        <a href="/help" class="no-underline text-slate-400 hover:text-blue-600">Help Center</a>
        {article.category && <span> / <span class={palette.accent}>{article.category.name}</span></span>}
      </nav>

      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-3xl md:text-4xl font-bold font-display tracking-tight text-slate-900 leading-tight">{article.title}</h1>
          <p class="mt-3 text-sm text-slate-400 font-sans">
            {article.author?.full_name ? `${article.author.full_name} · ` : ''}
            Updated {new Date(article.updated_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}
            {minutes ? ` · ${minutes} min read` : ''}
          </p>
        </div>
        <div class="flex gap-2 shrink-0">
          <button type="button" data-copy-link class="px-3 py-1.5 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold hover:bg-slate-200 cursor-pointer" title="Copy link">🔗 Copy link</button>
          <button type="button" onclick="window.print()" class="px-3 py-1.5 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold hover:bg-slate-200 cursor-pointer">🖨 Print</button>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-[200px_1fr] gap-10">
        {body.toc.length > 0 && (
          <nav class="hidden md:block sticky top-28 self-start" aria-label="Table of contents">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">On this page</p>
            <ul class="list-none p-0 m-0 flex flex-col gap-2 border-l border-slate-200 pl-4" data-toc>
              {body.toc.map((h) => (
                <li key={h.id}><a href={`#${h.id}`} class="text-sm text-slate-500 hover:text-blue-600 no-underline leading-snug block" data-toc-link>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        )}
        <div class="prose prose-slate max-w-none min-w-0">
          <Fragment set:html={body.html} />
        </div>
      </div>

      <div class="mt-14 pt-8 border-t border-slate-200 flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
        <form method="POST" action="/api/kb-feedback" data-feedback class="flex items-center gap-3">
          <input type="hidden" name="article_id" value={article.id} />
          <span class="text-sm text-slate-500 font-sans">Was this article helpful?</span>
          <button type="submit" name="helpful" value="true" class="px-4 py-2 rounded-full bg-emerald-50 text-emerald-700 text-sm font-semibold hover:bg-emerald-100 cursor-pointer">Yes ({article.helpful_yes ?? 0})</button>
          <button type="submit" name="helpful" value="false" class="px-4 py-2 rounded-full bg-slate-100 text-slate-600 text-sm font-semibold hover:bg-slate-200 cursor-pointer">No ({article.helpful_no ?? 0})</button>
        </form>
        <details class="text-sm">
          <summary class="cursor-pointer text-slate-500 hover:text-slate-700 font-medium">Spot a mistake? Suggest an edit</summary>
          <form method="POST" action="/api/kb-suggested-edit" class="mt-3 flex flex-col gap-2 bg-slate-50 rounded-xl p-4 w-full md:w-96">
            <input type="hidden" name="article_id" value={article.id} />
            <textarea name="suggestion" required rows="3" placeholder="What should we change?" class="border border-slate-300 rounded-lg px-3 py-2 text-sm font-sans" />
            <input type="email" name="contact_email" placeholder="Your email (optional)" class="border border-slate-300 rounded-lg px-3 py-2 text-sm font-sans" />
            <button type="submit" class="self-end px-4 py-2 rounded-full bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 cursor-pointer">Send suggestion</button>
          </form>
        </details>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="px-6 pb-20">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-xl font-bold font-display mb-6">Related articles</h2>
        <div class="flex flex-col gap-3">
          {related.map((r: any) => (
            <a href={r.page?.slug ?? '#'} class="bg-white rounded-xl border border-slate-200/80 px-5 py-4 no-underline hover:border-blue-300 transition-colors flex items-baseline justify-between gap-4">
              <span class="font-semibold text-slate-800">{r.title}</span>
              <span class="text-xs text-slate-400 shrink-0 font-sans">{r.reading_time_min ? `${r.reading_time_min} min` : ''}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
<script>
  // Sticky TOC scroll-spy (same behaviour as the previous help template)
  const links = Array.from(document.querySelectorAll('[data-toc-link]'));
  if (links.length) {
    const ids = links.map((l) => l.getAttribute('href')?.slice(1)).filter(Boolean);
    const headings = ids.map((id) => document.getElementById(id!)).filter(Boolean);
    const observer = new IntersectionObserver(
      (entries) => {
        let active = '';
        entries.forEach((e) => { if (e.isIntersecting) active = e.target.id; });
        if (active) {
          links.forEach((l) => l.classList.remove('text-blue-600', 'font-semibold'));
          const el = document.querySelector(`[data-toc-link][href="#${active}"]`);
          if (el) el.classList.add('text-blue-600', 'font-semibold');
        }
      },
      { rootMargin: '-80px 0px -60% 0px' },
    );
    headings.forEach((h) => observer.observe(h));
  }
  // Copy link
  const copyBtn = document.querySelector('[data-copy-link]');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(window.location.href); copyBtn.textContent = '✓ Copied'; } catch (_) {}
    });
  }
  // Feedback form → JSON POST, no reload
  const fb = document.querySelector('[data-feedback]');
  if (fb) {
    fb.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(fb);
      const res = await fetch('/api/kb-feedback', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(Object.fromEntries(fd)) });
      if (res.ok) { fb.innerHTML = '<p class="text-sm text-emerald-600 font-semibold">Thanks for the feedback!</p>'; }
    });
  }
</script>
