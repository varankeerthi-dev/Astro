---
// /help — DB-driven help center index with search (extends the existing
// Help section per PRD Phase 7 — same visual language, now CMS-driven).
import Layout from '../../layouts/Layout.astro';
import { listKbArticles, listKbCategories, listReleaseNotes } from '../../lib/cms/query';
import { cacheHeaders, cacheTagsFor } from '../../lib/cache';

export const prerender = false;

const [categories, recentArticles, recentNotes] = await Promise.all([
  listKbCategories(),
  listKbArticles({ limit: 6 }),
  listReleaseNotes(),
]);

const hasReleaseNotes = recentNotes.length > 0;

Astro.response.headers.set('Content-Type', 'text/html');
if (!Astro.locals.preview) {
  for (const [k, v] of Object.entries(cacheHeaders(cacheTagsFor('/help')))) Astro.response.headers.set(k, v);
}
---
<Layout title="Help Center - Documentation & Guides" description="Find step-by-step guides, user documentation, and FAQs. Learn how to manage projects, create quotes, and track inventory.">
  <section class="pt-32 pb-16 px-6 bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold font-display tracking-tight mb-4 text-slate-900">How can we help you?</h1>
      <p class="text-slate-500 text-lg max-w-md mx-auto font-sans">Browse our documentation or search help articles.</p>
      <form action="/search" method="get" class="mt-8 max-w-xl mx-auto flex gap-2" role="search">
        <input type="search" name="q" placeholder="Search the help center…" aria-label="Search help articles"
          class="flex-1 border border-slate-300 rounded-full px-5 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500 bg-white" />
        <button type="submit" class="px-6 py-3 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm cursor-pointer">Search</button>
      </form>
    </div>
  </section>

  {categories.length > 0 && (
    <section class="px-6 pb-12">
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
        {categories.map((c) => (
          <a href={`/help?category=${c.slug}`} class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs no-underline hover:border-blue-300 transition-colors">
            <h3 class="text-lg font-bold font-display mb-2 text-blue-600">{c.name}</h3>
            <p class="text-sm text-slate-500 mb-4 font-sans">{c.kind.replace('_', ' ')}</p>
            <span class="text-sm font-semibold text-slate-800 hover:text-blue-600 transition-colors no-underline font-sans">Browse →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {recentArticles.length > 0 && (
    <section class="px-6 pb-12">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-xl font-bold font-display mb-6">Recently updated</h2>
        <div class="flex flex-col gap-3">
          {recentArticles.map((a: any) => (
            <a href={a.page?.slug ?? '#'} class="bg-white rounded-xl border border-slate-200/80 px-5 py-4 no-underline hover:border-blue-300 transition-colors flex items-baseline justify-between gap-4">
              <span class="font-semibold text-slate-800">{a.title}</span>
              <span class="text-xs text-slate-400 shrink-0 font-sans">
                {a.category?.name ?? ''}
                {a.reading_time_min ? ` · ${a.reading_time_min} min` : ''}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {hasReleaseNotes && (
    <section class="px-6 pb-20">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-xl font-bold font-display mb-4">Release notes</h2>
        <a href="/help/release-notes" class="text-sm font-semibold text-blue-600 hover:text-blue-800 no-underline">View the timeline →</a>
      </div>
    </section>
  )}
</Layout>
